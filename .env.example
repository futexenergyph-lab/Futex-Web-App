# =============================================================================
# FUTEX Energy Solution — Environment variables
# =============================================================================
# Copy to .env.local and fill in from your Supabase project
# (Project Settings -> API).

# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — NEVER expose to the browser. Used by the seed script and any
# server-side admin actions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Default password applied to the demo accounts created by the seed script.
SEED_DEMO_PASSWORD=Futex2026!
